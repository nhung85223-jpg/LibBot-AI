# Copy file này thành .env.local để dùng cho local dev với `vercel dev`
# Trên production: add các biến này vào Vercel Dashboard → Settings → Environment Variables

GEMINI_API_KEY_1=your_key_1_here
GEMINI_API_KEY_2=your_key_2_here
GEMINI_API_KEY_3=your_key_3_here
GEMINI_API_KEY_4=your_key_4_here

# Optional - default là gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
